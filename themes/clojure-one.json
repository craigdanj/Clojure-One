  "semanticTokenColors": {
    "namespace": "#61afef",
    "type": "#56b6c2",
    "type:clojure": "#61afef",
    "type:clojurescript": "#61afef",
    "class": "#56b6c2",
    "enum": "#56b6c2",
    "interface": "#56b6c2",
    "struct": "#56b6c2",
    "function": "#98c379",
    "method": "#98c379",
    "macro": "#e06c75",
    "keyword": "#c678dd",
    "variable": "#abb2bf",
    "variable:clojure": "#d19a66",
    "variable:clojurescript": "#d19a66",
    "parameter": "#d19a66",
    "parameter:clojure": "#d19a66",
    "parameter:clojurescript": "#d19a66",
    "property": "#abb2bf",
    "event": "#abb2bf",
    "comment": "#5c6370",
    "string": "#e5c07b",
    "number": "#d19a66",
    "regexp": "#e5c07b",
    "operator": "#abb2bf"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#5c6370"
      }
    },
    {
      "name": "Strings and regexes",
      "scope": [
        "string",
        "string.quoted.double.clojure",
        "string.regexp.clojure"
      ],
      "settings": {
        "foreground": "#e5c07b"
      }
    },
    {
      "name": "String escapes",
      "scope": ["constant.character.escape"],
      "settings": {
        "foreground": "#56b6c2"
      }
    },
    {
      "name": "Numbers",
      "scope": ["constant.numeric"],
      "settings": {
        "foreground": "#d19a66"
      }
    },
    {
      "name": "nil, true, and false",
      "scope": [
        "constant.language.nil.clojure",
        "constant.language.boolean.clojure"
      ],
      "settings": {
        "foreground": "#d19a66"
      }
    },
    {
      "name": "Clojure keywords",
      "scope": ["constant.keyword", "constant.keyword.clojure"],
      "settings": {
        "foreground": "#c678dd"
      }
    },
    {
      "name": "Core forms (defn, def, if, let, fn, ns)",
      "scope": ["storage.control.clojure", "keyword.control"],
      "settings": {
        "foreground": "#e06c75"
      }
    },
    {
      "name": "Function names and definitions",
      "scope": [
        "entity.name.function",
        "entity.global.clojure",
        "support.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#98c379"
      }
    },
    {
      "name": "Namespaces and imports",
      "scope": [
        "entity.name.namespace",
        "entity.name.namespace.clojure",
        "entity.name.namespace.prompt.clojure"
      ],
      "settings": {
        "foreground": "#61afef"
      }
    },
    {
      "name": "Class and type identifiers",
      "scope": [
        "entity.name.class",
        "entity.name.type",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#56b6c2"
      }
    },
    {
      "name": "Symbols",
      "scope": [
        "entity.name.variable.clojure",
        "entity.name.variable.dynamic.clojure",
        "meta.var.clojure",
        "variable.parameter.clojure"
      ],
      "settings": {
        "foreground": "#d19a66"
      }
    },
    {
      "name": "REPL prompt",
      "scope": ["keyword.control.prompt.clojure"],
      "settings": {
        "foreground": "#528bff"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation.section.expression",
        "punctuation.section.vector",
        "punctuation.section.map",
        "punctuation.section.set",
        "punctuation.section.metadata"
      ],
      "settings": {
        "foreground": "#abb2bf"
      }
    }
  ]
}
